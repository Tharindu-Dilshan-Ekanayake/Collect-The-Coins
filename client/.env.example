# Optional local overrides: copy to `.env.local`. Nothing here is required.

# The game's Boxity id (the default already is collect-the-coins).
VITE_GAME_SLUG=collect-the-coins

# Boxity endpoints are NOT configured here: the platform tells the game its
# environment (prod / stage / local). `npm run dev` uses real Boxity accounts and
# avatars; start it with BLOXITY_DEV_ENV=local (a shell variable, not a VITE_ one) only
# if you run the local Boxity stack (portal :3000, API :4000, game server :2568).

# Boxity hosting id of the game server (Legion.SDK.net.resolveEndpoint). Not a URL.
# Production builds get it from .env.production; leave it unset for local dev so the
# game uses your own server from server/ (npm run dev, ws://localhost:2568).
# VITE_BLOXITY_HOSTING_ID=collect-the-coins

# Only for a game server NOT hosted on Boxity.
# VITE_GAME_SERVER=wss://your-server.example
