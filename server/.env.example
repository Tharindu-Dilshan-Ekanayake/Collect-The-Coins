# Game server settings. Boxity hosting injects the BLOXITY_* values on every deploy;
# set them yourself only when running elsewhere. Missing values fall back to prod.

# Local default is 2568 (Boxity hosting sets PORT=2567 itself).
PORT=2568
# Comma-separated origins allowed to call the HTTP API (auth). Local dev defaults to
# the Vite dev/preview servers.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Told environment (prod | stage | local) and its URLs.
# BLOXITY_ENV=local
# BLOXITY_API_URL=http://localhost:4000
# BLOXITY_MATCHMAKER_URL=http://localhost:2567
# BLOXITY_PORTAL_URL=http://localhost:3000
# BLOXITY_STATIC_URL=

# The game's slug (used when verifying player tokens).
# BLOXITY_GAME_SLUG=collect-the-coins

# Server-side leaderboard reports. Without these, no scores are sent (local dev).
# BLOXITY_GAME_ID=
# BLOXITY_REPORT_TOKEN=

# Injected by Boxity hosting (set them yourself only when running elsewhere):
# CLIENT_ORIGIN=https://your-game.example   # CORS origin of your game site
# MONGODB_URI=mongodb://...                 # saves signed-in players' progress per map.
#                                           # Without it, progress goes to server/data/progress.json.
